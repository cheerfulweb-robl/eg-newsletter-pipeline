# Disable directory browsing
Options -Indexes

# Protect hidden files (like .htaccess or .env if ever uploaded)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# React Router Single Page Application Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Server-side 301 Permanent Redirects for retired Hamper & Merchant Perks (QSD drops query params, NC = case insensitive)
  RewriteRule ^(hamper-perks|claim|partner|wallet|redemption|verify)(/.*)?$ /events [R=301,L,NC,QSD]

  # Redirect legacy /admin to staff operations portal
  RewriteRule ^admin/?$ /staff/admin-approvals.html [R=301,L,NC]

  RewriteRule ^events/?$ /index.html [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
