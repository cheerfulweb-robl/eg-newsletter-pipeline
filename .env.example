# ==============================================================================
# Local Community Platform — Environment & Secrets Reference
# Copy relevant values to site-src/.env (frontend) and GitHub/Supabase Secrets.
# Never commit real .env files or secret keys to git.
# ==============================================================================

# --- Frontend (site-src/.env) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_DEFAULT_MUNICIPALITY=Your Town, ON
VITE_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# --- GitHub Actions Pipeline & Backups (Repository Secrets) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
BREVO_API_KEY=YOUR_BREVO_API_KEY
TEST_RECIPIENT=admin@yourdomain.ca

# --- Supabase Edge Function Secrets (supabase secrets set ...) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
ADMIN_ALERT_EMAIL=admin@yourdomain.ca
